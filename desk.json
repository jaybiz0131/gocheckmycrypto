{
  "note": "The desk register: what this newsroom is configured to run, in one place. Two checks read it. The canary asserts the workflow files match it exactly, so a stale cron or a placeholder cannot survive a push. The morning tally compares the Actions log and the ledger to it and prints one health line. Cron times are UTC; the ET column is Eastern and shifts by an hour when DST ends on 1 November.",
  "desk": "gocheckmycrypto",
  "updated": "2026-09-17",
  "paid_runs_per_day": 1,
  "breaking_runs_per_day": 2,
  "spend_cap_usd_per_run": 1.5,
  "served_slots": [
    "evening-brief"
  ],
  "netlify_builds_per_day": {
    "min": 1,
    "max": 6
  },
  "worker_dispatches": [
    "watcher.yml on the half hour during US hours",
    "crypto-news-brief.yml at the evening slot, as the cron's backstop"
  ],
  "workflows": {
    "crypto-news-brief.yml": {
      "purpose": "The one Edition run a day. Ingest, edit, verify, write, approve, publish.",
      "crons": [
        {
          "utc": "8 23 * * *",
          "et": "7:08 PM",
          "slot": "evening-brief"
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch",
        "workflow_call"
      ],
      "runs_per_day": {
        "min": 1,
        "max": 8
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 3
      },
      "note": "One scheduled Edition plus at most two breaking runs fired by the caged watcher. Everything else stands down at the slot guard."
    },
    "watcher.yml": {
      "purpose": "The caged breaking-news watcher. No model call unless the cage clears.",
      "crons": [
        {
          "utc": "17 12-23 * * *",
          "et": "8:17 AM-7:17 PM hourly",
          "slot": null
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 12,
        "max": 44
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 2
      },
      "note": "Earning categories only, five sources, two runs a day, price triggers off. A tick that does not clear the cage makes no model call."
    },
    "site-refresh.yml": {
      "purpose": "Retired on the deploy budget, 21 September 2026. This fired at 12:00 UTC, 8 AM Eastern, while the Worker already fires this desk's build hook at noon Eastern: two scheduled deploys where the budget allows one. Kept for workflow_dispatch so a refresh can be asked for by hand.",
      "crons": [],
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 1,
        "max": 1
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      }
    },
    "verify-crypto-pipeline.yml": {
