+  const { hour, minute } = easternParts(now);
+  const m = hour * 60 + minute, at = HEALTH_ET.hour * 60 + HEALTH_ET.minute;
+  return m >= at && m < at + TICK_MINUTES ? [{ ...HEALTH }] : [];
+}
