index 0000000..3bc2dcb
--- /dev/null
+++ b/slot-trigger/test/health.test.mjs
@@ -0,0 +1,22 @@
+// The health gate's dispatch. Run: node slot-trigger/test/health.test.mjs
+import { __test } from "../src/worker.js";
+const { healthDue, HEALTH } = __test;
+
+let pass = 0, fail = 0;
+const ok = (c, w) => { if (c) pass++; else { fail++; console.log("  FAIL " + w); } };
+const at = iso => new Date(iso);
+
+ok(healthDue(at("2026-11-26T12:05:00Z")).length === 1, "7:05 AM EST = 12:05Z fires");
+ok(healthDue(at("2026-11-26T12:09:00Z")).length === 1, "the tick's five minutes fire");
+ok(healthDue(at("2026-11-26T12:10:00Z")).length === 0, "7:10 AM EST does not");
+ok(healthDue(at("2026-11-26T11:05:00Z")).length === 0, "11:05Z in EST is 6:05 AM: does not fire");
+ok(healthDue(at("2026-07-14T11:05:00Z")).length === 1, "7:05 AM EDT = 11:05Z fires");
+ok(healthDue(at("2026-07-14T12:05:00Z")).length === 0, "12:05Z in EDT is 8:05 AM: does not fire");
+ok(HEALTH.repo === "gocheckmycrypto" && HEALTH.wf === "health.yml" && HEALTH.slot === null, "it dispatches the crypto health gate with no slot");
+for (const day of ["2026-07-14", "2026-11-26"]) {
+  let n = 0;
+  for (let t = Date.parse(day + "T00:00:00Z"); t < Date.parse(day + "T00:00:00Z") + 86400000; t += 300000) n += healthDue(new Date(t)).length;
+  ok(n === 1, `${day}: one health dispatch across 288 ticks, got ${n}`);
+}
+console.log(`health dispatch: ${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
